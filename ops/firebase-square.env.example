# Configure these in the API's private Square Cloud deployment settings.
# This central API is separate from the individual customer bot applications.
NODE_ENV=production
HOST=0.0.0.0
PORT=80
APP_ORIGIN=https://blackout-create.web.app
API_PUBLIC_ORIGIN=https://blackout-create-api.squareweb.app
FIREBASE_PROJECT_ID=blackout-create
PLATFORM_DATABASE=firestore
# Use the SDK's HTTPS/REST transport on Square Cloud.
FIRESTORE_PREFER_REST=true
API_AUTH_MODE=bearer
FIREBASE_HOSTING=false
TRUST_PROXY_HOPS=0
# Required private secrets; inject actual values through protected hosting settings:
# BOT_TOKEN_ENCRYPTION_KEY=32-random-bytes-as-base64url
# ADMIN_MFA_ENCRYPTION_KEY=a-different-32-random-bytes-as-base64url
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase-admin.json
# Do not put the private credential file inside the code upload.
# Do not enable emulator variables or Firebase/Google Cloud billing.
# Frontend BUILD settings (public, not server secrets):
# VITE_API_ORIGIN=https://blackout-create-api.squareweb.app
# VITE_CONTACT_URL=https://your-actual-public-contact
