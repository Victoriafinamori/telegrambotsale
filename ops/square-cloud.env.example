# Reference only; no Square Cloud domain, port or capability has been verified.
NODE_ENV=production
HOST=0.0.0.0
# Confirm the HTTP port forwarded by the hosting.
PORT=3000
# Replace with the real HTTPS origin without a trailing slash.
APP_ORIGIN=https://replace-with-your-actual-domain.example
FIREBASE_PROJECT_ID=blackout-create
FIREBASE_HOSTING=false
DATABASE_SSL=true
# Validate the real proxy chain before changing this.
TRUST_PROXY_HOPS=0
# Configure DATABASE_URL and BOT_TOKEN_ENCRYPTION_KEY separately as private secrets.
# GOOGLE_APPLICATION_CREDENTIALS, if needed, must reference a protected server file.
# Never set FIREBASE_AUTH_EMULATOR_HOST in production.
