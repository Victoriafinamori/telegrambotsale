# Registered Firebase Web app: config/firebase.web.json (public configuration).
# npm run local overrides these defaults with an isolated demo emulator.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
FIREBASE_PROJECT_ID=blackout-create
# Central platform: firestore for production; npm run local forces isolated PostgreSQL.
PLATFORM_DATABASE=firestore
# Use bearer when frontend is in Firebase Hosting and API in Square Cloud.
API_AUTH_MODE=bearer
# VITE_API_ORIGIN=https://your-actual-square-api-origin
# ADMIN_MFA_ENCRYPTION_KEY must be a separate private base64url key (32 bytes).
# Optional public sales contact, baked into the browser bundle at build time.
# VITE_CONTACT_URL=https://your-actual-public-contact-link
# For a different Firebase project, also set its matching public Web configuration:
# FIREBASE_WEB_API_KEY=...
# FIREBASE_AUTH_DOMAIN=...
# FIREBASE_APP_ID=...
# Never set FIREBASE_AUTH_EMULATOR_HOST for the real project.
# Square Cloud API with Firebase Hosting frontend: see ops/firebase-square.env.example.
# See docs/SQUARE-CLOUD.md and ops/square-cloud.env.example.
FIREBASE_HOSTING=false
# npm run local uses an embedded PostgreSQL database, for local development only.
# Production Firestore requires a dedicated trusted server identity.
# PostgreSQL remains available explicitly with PLATFORM_DATABASE=postgres.
# BOT_TOKEN_ENCRYPTION_KEY: stable 32 random bytes encoded as base64url, injected privately.
# Required for protected bot-token intake; never send its value through chat or commit it.
# DATABASE_URL=postgresql://user:password@host:5432/blackout
# DATABASE_SSL=true
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# Explicit trusted proxy hops, only when required by your deployment.
TRUST_PROXY_HOPS=0
