{
  "name": "blackout-create",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/main.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:emulator": "node --import tsx scripts/emulator.ts --test",
    "emulators": "node --import tsx scripts/emulator.ts",
    "db:migrate": "node dist-server/scripts/migrate.js",
    "admin:grant": "node dist-server/scripts/grant-admin.js",
    "local": "node --import tsx scripts/local.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "admin:mfa-reset": "node dist-server/scripts/reset-admin-mfa.js",
    "firebase:prepare": "node --import tsx scripts/prepare-hosting.ts",
    "firebase:login": "node --import tsx scripts/firebase-cli.ts login",
    "firebase:status": "node --import tsx scripts/firebase-cli.ts status",
    "deploy:hosting": "npm run build && npm run firebase:prepare && node --import tsx scripts/firebase-cli.ts hosting",
    "deploy:rules": "node --import tsx scripts/firebase-cli.ts rules",
    "secrets:generate": "node --import tsx scripts/generate-server-secrets.ts",
    "test:admin-browser": "node --import tsx tests/admin-browser.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "firebase-tools": "^15.34.1",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
